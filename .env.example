# Docker Compose values
MYSQL_DATABASE=campusconnect
MYSQL_USER=campus_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_ORIGIN=http://localhost:5173

# Optional OpenAI-compatible provider (OmniRoute local example)
AI_BASE_URL=http://host.docker.internal:20128/v1
AI_API_KEY=replace-with-your-provider-key
AI_MODEL=replace-with-your-provider-model

# Optional embedding model. Leave blank to use lexical retrieval fallback.
AI_EMBEDDING_MODEL=your-provider-embedding-model
